<Window x:Class="TicTacToeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TicTacToeApp.Models"
        Title="Лабораторна робота №2 — Хрестики-нулики"
        Width="540"
        Height="640"
        MinWidth="460"
        MinHeight="560"
        Background="#F6F8FA">

    <Window.Resources>
        <Style x:Key="BoardCellButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CellBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CellBorder" Property="Background" Value="#F0F6FC"/>
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="#1565C0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:CellState.X}">
                    <Setter Property="Foreground" Value="#1565C0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:CellState.O}">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWinningCell}" Value="True">
                    <Setter Property="Background" Value="#E6F4EA"/>
                    <Setter Property="BorderBrush" Value="#2E7D32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGameOver}" Value="True">
                    <Setter Property="Background" Value="#EEF6FF"/>
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Панель керування -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Складність:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#24292F"
                       Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding DifficultyOptions}"
                      SelectedItem="{Binding SelectedDifficulty}"
                      DisplayMemberPath="DisplayName"
                      Padding="6,4"
                      VerticalContentAlignment="Center"/>

            <Button Grid.Column="3"
                    Content="Нова гра"
                    Command="{Binding NewGameCommand}"
                    Padding="14,6"
                    FontWeight="SemiBold"
                    Background="#1565C0"
                    Foreground="White"
                    BorderThickness="0"/>
        </Grid>

        <!-- Статус партії -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource StatusBannerStyle}"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#1F2328"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Рахунок -->
        <Border DockPanel.Dock="Bottom"
                Background="#FFFFFF"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,12,0,0">
            <UniformGrid Columns="3">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Людина (X)" FontSize="12" Foreground="#57606A" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding HumanWins}" FontSize="18" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Нічиї" FontSize="12" Foreground="#57606A" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Draws}" FontSize="18" FontWeight="Bold" Foreground="#24292F" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Комп'ютер (O)" FontSize="12" Foreground="#57606A" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ComputerWins}" FontSize="18" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Ігрове поле N×N -->
        <Border Background="#FFFFFF"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding BoardSize}"
                                     Columns="{Binding BoardSize}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Symbol}"
                                IsEnabled="{Binding IsEnabled}"
                                Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource BoardCellButtonStyle}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DockPanel>
</Window>
