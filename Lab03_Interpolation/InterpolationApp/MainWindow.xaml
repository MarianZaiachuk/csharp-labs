<Window x:Class="InterpolationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №3 — Лінійна та кубічна інтерполяція Ерміта"
        Width="1040"
        Height="720"
        MinWidth="820"
        MinHeight="580"
        Background="#F6F8FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LegendCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ліва панель керування -->
        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Параметри інтерполяції"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1F2328"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Еталонна функція f(x)" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Functions}"
                              SelectedItem="{Binding SelectedFunction}"
                              DisplayMemberPath="DisplayName"
                              Padding="6,4"/>

                    <TextBlock Text="Крок опорних точок h₁ (0.05–5.0)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding H1Text, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"/>
                    <TextBlock Text="{Binding H1Error}" Style="{StaticResource ErrorTextStyle}"/>

                    <TextBlock Text="Крок інтерполяції h₂ (h₂ &lt; h₁)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding H2Text, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"/>
                    <TextBlock Text="{Binding H2Error}" Style="{StaticResource ErrorTextStyle}"/>

                    <CheckBox Content="Нерівновіддалені вузли A₁"
                              IsChecked="{Binding UseNonUniformKnots}"
                              Margin="0,10,0,6"
                              FontWeight="SemiBold"/>

                    <Separator Margin="0,6,0,6"/>

                    <TextBlock Text="Видимість кривих" Style="{StaticResource FieldLabelStyle}"/>

                    <CheckBox IsChecked="{Binding ShowReference}" Style="{StaticResource LegendCheckBoxStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="16" Height="3" Fill="#6B7280" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Еталонна функція f(x)"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding ShowSupportPoints}" Style="{StaticResource LegendCheckBoxStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#B91C1C" VerticalAlignment="Center" Margin="3,0,11,0"/>
                            <TextBlock Text="Опорні точки A₁"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding ShowLinear}" Style="{StaticResource LegendCheckBoxStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="16" Height="3" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Лінійна інтерполяція"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding ShowHermite}" Style="{StaticResource LegendCheckBoxStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="16" Height="3" Fill="#1565C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Інтерполяція Ерміта"/>
                        </StackPanel>
                    </CheckBox>

                    <Button Content="Побудувати"
                            Command="{Binding BuildCommand}"
                            Height="34"
                            Margin="0,14,0,0"
                            FontWeight="SemiBold"
                            Background="#1565C0"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Права область графіків -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.65*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Основний графік інтерполяції -->
            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Порівняння еталонної функції, лінійної та кубічної інтерполяції Ерміта"
                               FontWeight="SemiBold"
                               Foreground="#24292F"
                               Margin="0,0,0,4"/>
                    <Grid>
                        <Canvas x:Name="MainPlotCanvas"
                                Background="#FFFFFF"
                                ClipToBounds="True"
                                SizeChanged="MainPlotCanvas_SizeChanged">
                            <Line X1="0"
                                  X2="{Binding MainCanvasWidth}"
                                  Y1="{Binding MainZeroAxisY}"
                                  Y2="{Binding MainZeroAxisY}"
                                  Stroke="#D0D7DE"
                                  StrokeThickness="1"/>
                            <Polyline Points="{Binding ReferencePoints}"
                                      Stroke="#6B7280"
                                      StrokeThickness="1.75"
                                      StrokeDashArray="4 3"
                                      Visibility="{Binding ShowReference, Converter={StaticResource BoolToVis}}"/>
                            <Polyline Points="{Binding LinearPoints}"
                                      Stroke="#D97706"
                                      StrokeThickness="2"
                                      Visibility="{Binding ShowLinear, Converter={StaticResource BoolToVis}}"/>
                            <Polyline Points="{Binding HermitePoints}"
                                      Stroke="#1565C0"
                                      StrokeThickness="2.2"
                                      Visibility="{Binding ShowHermite, Converter={StaticResource BoolToVis}}"/>
                        </Canvas>

                        <ItemsControl ItemsSource="{Binding SupportMarkers}"
                                      Visibility="{Binding ShowSupportPoints, Converter={StaticResource BoolToVis}}"
                                      IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="#B91C1C"
                                             Stroke="#FFFFFF"
                                             StrokeThickness="1.2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Графік абсолютної похибки -->
            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ErrorSummaryText}"
                                   FontSize="12"
                                   Foreground="#57606A"/>
                        <TextBlock Text="Абсолютна похибка |y_інтерп(x) − f(x)|"
                                   FontWeight="SemiBold"
                                   Foreground="#24292F"/>
                    </DockPanel>
                    <Canvas x:Name="ErrorPlotCanvas"
                            Background="#FFFFFF"
                            ClipToBounds="True"
                            SizeChanged="ErrorPlotCanvas_SizeChanged">
                        <Line X1="0"
                              X2="{Binding ErrorCanvasWidth}"
                              Y1="{Binding ErrorBaselineY}"
                              Y2="{Binding ErrorBaselineY}"
                              Stroke="#D0D7DE"
                              StrokeThickness="1"/>
                        <Polyline Points="{Binding LinearErrorPoints}"
                                  Stroke="#D97706"
                                  StrokeThickness="1.8"
                                  Visibility="{Binding ShowLinear, Converter={StaticResource BoolToVis}}"/>
                        <Polyline Points="{Binding HermiteErrorPoints}"
                                  Stroke="#1565C0"
                                  StrokeThickness="2"
                                  Visibility="{Binding ShowHermite, Converter={StaticResource BoolToVis}}"/>
                    </Canvas>
                </DockPanel>
            </Border>

            <!-- Рядок стану -->
            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="#24292F"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Grid>
</Window>
