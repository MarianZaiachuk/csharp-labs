<Window x:Class="IntegrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №4 — Чисельне інтегрування (Strategy)"
        Width="1060"
        Height="700"
        MinWidth="840"
        MinHeight="560"
        Background="#F6F8FA">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Параметри інтегрування"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1F2328"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Підінтегральна функція f(x)" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Functions}"
                              SelectedItem="{Binding SelectedFunction}"
                              DisplayMemberPath="DisplayName"
                              Padding="6,4"/>

                    <TextBlock Text="Активна стратегія (IIntegrator)" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Strategies}"
                              SelectedItem="{Binding SelectedStrategy}"
                              DisplayMemberPath="Name"
                              Padding="6,4"/>

                    <TextBlock Text="Нижня межа інтегрування a" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding AText, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"/>
                    <TextBlock Text="{Binding AError}" Style="{StaticResource ErrorTextStyle}"/>

                    <TextBlock Text="Верхня межа інтегрування b" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding BText, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"/>
                    <TextBlock Text="{Binding BError}" Style="{StaticResource ErrorTextStyle}"/>

                    <TextBlock Text="Кількість інтервалів n (1–1 000 000)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding IntervalsText, UpdateSourceTrigger=PropertyChanged}" Padding="5,4"/>
                    <TextBlock Text="{Binding IntervalsError}" Style="{StaticResource ErrorTextStyle}"/>

                    <CheckBox Content="Логарифмічна шкала похибки (log₁₀)"
                              IsChecked="{Binding UseLogScale}"
                              Margin="0,10,0,4"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Обчислити"
                                Command="{Binding CalculateCommand}"
                                Height="34"
                                FontWeight="SemiBold"
                                Background="#1565C0"
                                Foreground="White"
                                BorderThickness="0"/>
                        <Button Grid.Column="2"
                                Content="a ↔ b"
                                Command="{Binding SwapBoundsCommand}"
                                Height="34"
                                Padding="12,0"
                                ToolTip="Поміняти місцями межі a та b"/>
                    </Grid>

                    <Border Background="#F6F8FA"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Результат обраної стратегії"
                                       FontWeight="SemiBold"
                                       Foreground="#24292F"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedStrategySummary}"
                                       FontSize="12"
                                       Foreground="#1F2328"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Порівняння методів чисельного інтегрування"
                               FontWeight="SemiBold"
                               Foreground="#24292F"
                               Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding ComparisonRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#D0D7DE"
                              BorderThickness="1"
                              RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Метод" Binding="{Binding MethodName}" Width="155"/>
                            <DataGridTextColumn Header="Результат" Binding="{Binding ApproximationText}" Width="105"/>
                            <DataGridTextColumn Header="Еталон" Binding="{Binding ExactValueText}" Width="105"/>
                            <DataGridTextColumn Header="Абс. похибка" Binding="{Binding AbsoluteErrorText}" Width="100"/>
                            <DataGridTextColumn Header="Відн. похибка" Binding="{Binding RelativeErrorText}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusNote}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ChartScaleHint}"
                                   FontSize="12"
                                   Foreground="#57606A"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Залежність похибки від n"
                                       FontWeight="SemiBold"
                                       Foreground="#24292F"
                                       Margin="0,0,14,0"/>
                            <Rectangle Width="14" Height="3" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Прямокутники" FontSize="12" Margin="0,0,10,0"/>
                            <Rectangle Width="14" Height="3" Fill="#7C3AED" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Трапеції" FontSize="12" Margin="0,0,10,0"/>
                            <Rectangle Width="14" Height="3" Fill="#1565C0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Сімпсон" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl DockPanel.Dock="Bottom"
                                  ItemsSource="{Binding ConvergenceStepLabels}"
                                  Margin="16,4,16,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="11"
                                           Foreground="#57606A"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Canvas x:Name="ErrorCanvas"
                            Background="#FFFFFF"
                            ClipToBounds="True"
                            SizeChanged="ErrorCanvas_SizeChanged">
                        <Line X1="0"
                              X2="{Binding CanvasWidth}"
                              Y1="{Binding BaselineY}"
                              Y2="{Binding BaselineY}"
                              Stroke="#D0D7DE"
                              StrokeThickness="1"/>
                        <Polyline Points="{Binding RectangleErrorPoints}"
                                  Stroke="#D97706"
                                  StrokeThickness="2"/>
                        <Polyline Points="{Binding TrapezoidErrorPoints}"
                                  Stroke="#7C3AED"
                                  StrokeThickness="2"/>
                        <Polyline Points="{Binding SimpsonErrorPoints}"
                                  Stroke="#1565C0"
                                  StrokeThickness="2.2"/>
                    </Canvas>
                </DockPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="#24292F"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Grid>
</Window>
